post_install() {
  printf '%s\n' 'Predator Sense: enable boot fan management once with:'
  printf '%s\n' '  systemctl enable --now predator-sensed.service'
  printf '%s\n' 'Run predator-sense-check as your desktop user to verify installation.'
}

pre_upgrade() {
  # Retire the obsolete competing writer without opting users into a new service.
  systemctl disable --now predator-sense.service >/dev/null 2>&1 || true
  # Stop old Python code before files are replaced; retain enabled status and state.
  systemctl stop predator-sensed.service >/dev/null 2>&1 || true
}

post_upgrade() {
  printf '%s\n' 'Predator Sense upgraded; start predator-sensed.service when ready.'
  printf '%s\n' 'Saved cooling state and the existing boot-enable setting are preserved.'
}

pre_remove() {
  systemctl disable --now predator-sensed.service >/dev/null 2>&1 || true
  systemctl disable --now predator-sense.service >/dev/null 2>&1 || true
}

post_remove() {
  printf '%s\n' 'Predator Sense removed. Saved cooling state under /var/lib/predator-sense was preserved.'
  printf '%s\n' 'To remove saved cooling state: rm -rf /var/lib/predator-sense'
}
