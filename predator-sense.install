post_install() {
  # Preserve state.json, but retire the competing legacy CoolBoost enforcer.
  systemctl disable --now predator-sense.service >/dev/null 2>&1 || true
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable --now predator-sensed.service >/dev/null 2>&1 || true
}

post_upgrade() {
  post_install
  systemctl try-restart predator-sensed.service >/dev/null 2>&1 || true
}

pre_remove() {
  systemctl disable --now predator-sensed.service >/dev/null 2>&1 || true
  systemctl disable --now predator-sense.service >/dev/null 2>&1 || true
}

post_remove() {
  systemctl daemon-reload >/dev/null 2>&1 || true
}
