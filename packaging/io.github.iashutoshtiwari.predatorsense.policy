<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<policyconfig>
  <vendor>Predator Sense</vendor>
  <vendor_url>https://github.com/iashutoshtiwari/predator-sense</vendor_url>
  <action id="io.github.iashutoshtiwari.predatorsense.control">
    <description>Control Predator G3-572 cooling</description>
    <message>Administrator authentication is required to change fan control or CoolBoost.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>
</policyconfig>
